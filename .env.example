# Copy this file to .env and fill in your values before running install.sh
# cp .env.example .env

GIT_USER_NAME=
GIT_USER_EMAIL=

# CleanShot: find your activation key in CleanShot preferences
CLEANSHOT_ACTIVATION_KEY=

# Signal account in E.164 format, for the signal-cli daemon that Hermes Agent
# talks to. Leave empty to skip installing the LaunchAgent.
# The device must first be linked once: signal-cli link -n "HermesAgent"
SIGNAL_ACCOUNT=
