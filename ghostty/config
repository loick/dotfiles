macos-option-as-alt = true
command = /bin/zsh --login
selection-word-chars = -_~.'

# --- Typography ---
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
font-thicken = true
font-thicken-strength = 100

# --- Theme and Colors ---
theme = Catppuccin Mocha

# --- Window and Appearance ---
background-opacity = 0.9
background-blur = macos-glass-regular
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-balance = true
window-padding-color = extend
window-save-state = always
window-new-tab-position = end

# --- Cursor ---
cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
selection-clear-on-copy = true

# --- Splits ---
unfocused-split-opacity = 0.85
split-divider-color = #45475a
resize-overlay-position = bottom-right

# --- Keybindings ---
keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = shift+enter=text:\n
keybind = cmd+shift+left=text:\x1byl
keybind = cmd+shift+right=text:\x1byr

# Make Cmd+V paste images (e.g. a Shottr capture) into a TUI. A terminal paste
# only writes text bytes into the pty, and an image clipboard has no text
# representation, so a plain paste sends nothing. Claude Code reads the macOS
# clipboard itself, binds that to Ctrl+V, and falls back to pasting clipboard
# text when there is no image -- so emitting its byte (0x16) covers both cases.
# The remap has to happen here: Claude Code refuses to bind cmd+v, reserving it
# as the macOS system paste. Zsh binds ^V to a pbpaste widget (see zsh/.zshrc)
# so pasting at the prompt keeps working; Cmd+Shift+V stays a plain terminal
# paste for TUIs that treat 0x16 as literal-insert (vim, less).
keybind = cmd+v=text:\x16
keybind = cmd+shift+v=paste_from_clipboard

# --- Performance ---
scrollback-limit = 100000

# --- Updates ---
# Disable in-app auto-updates. Ghostty's Sparkle updater replaces the .app
# bundle under a running process, which invalidates the Full Disk Access
# TCC grant (CDHash mismatch) and silently breaks FDA until toggled off/on.
# Update via `brew upgrade --cask ghostty` with the app quit instead.
auto-update = off
auto-update-channel = stable
